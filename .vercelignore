# Applied to all Vercel projects in this monorepo.
# Do NOT exclude frontend/ here — frontend-medical-rag rootDirectory is
# "frontend" and needs those files. Backend excludes frontend via vercel.json.

# Virtual environments
.venv
.venv/
.venv-bundle-check/
venv/
env/
ENV/

# Python caches / build artifacts
__pycache__/
**/__pycache__/
*.py[cod]
*.egg-info/
**/*.egg-info/
.eggs/
build/
*.egg

# Git
.git/
.gitignore

# Widget source only (keep widget/dist for FastAPI StaticFiles)
widget/node_modules/
widget/src/
widget/package.json
widget/package-lock.json
widget/tsconfig.json
widget/vite.config.*
widget/index.html

# Logs & local data
logs/
*.log
data/
*.db
*.sqlite
*.sqlite3

# Scripts, tests, eval (not needed at runtime)
scripts/
tests/
**/test_*.py
**/*_test.py
**/tests/
pytest.ini
.pytest_cache/
.coverage
htmlcov/
requirements-dev.txt
BUNDLE_AUDIT.md

# ML / HuggingFace / torch model caches (must never ship)
.cache/
.cache/**
**/huggingface/
**/.huggingface/
torch/
transformers/
**/sentence_transformers/
**/models--*/
*.pt
*.bin
*.safetensors
*.onnx

# IDE / OS
.idea/
.vscode/
.cursor/
.DS_Store
*.swp
