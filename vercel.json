{
  "functions": {
    "api/main.py": {
      "maxDuration": 60,
      "includeFiles": "{api/**,widget/dist/**}",
      "excludeFiles": "{.venv/**,venv/**,__pycache__/**,**/*.pyc,.git/**,frontend/**,widget/node_modules/**,widget/src/**,logs/**,data/**,scripts/**,tests/**,**/*.egg-info/**,.cache/**,**/huggingface/**,torch/**,transformers/**,**/*.db,**/*.sqlite,**/*.sqlite3}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/main.py"
    },
    {
      "source": "/health",
      "destination": "/api/main.py"
    },
    {
      "source": "/widget/(.*)",
      "destination": "/api/main.py"
    },
    {
      "source": "/ws/(.*)",
      "destination": "/api/main.py"
    },
    {
      "source": "/docs",
      "destination": "/api/main.py"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/main.py"
    },
    {
      "source": "/",
      "destination": "/api/main.py"
    }
  ]
}
